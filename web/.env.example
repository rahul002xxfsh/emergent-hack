# Copy to .env.local and fill in. Every key is optional: without them the app still works
# (scripted demo replies + the browser's own voice).

# Live in-character replies (Claude)
ANTHROPIC_API_KEY=
# Optional: defaults to claude-opus-5-5 (effort low). Set e.g. claude-haiku-5-5 for cheaper replies.
CLAUDE_MODEL=

# Celebrity-style voices for replies, tried in this order
FISH_API_KEY=          # Fish Audio: main voice for all four therapists
FISH_MODEL=            # optional, defaults to s2.1-pro-free
ANYTOSPEECH_API_KEY=   # backup for Trump
MAGIC_HOUR_API_KEY=    # backup for Trump, Snoop Dogg and Amitabh Bachchan
